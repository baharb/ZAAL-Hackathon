{
  "expo": {
    "name": "ZAAL",
    "slug": "zaal",
    "version": "1.1.11",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B21A8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaal.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "18"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B21A8"
      },
      "package": "com.zaal.app",
      "versionCode": 18
    },
    "plugins": [
      "./plugins/withRemoveForegroundServiceMediaPlayback.js",
      "./plugins/withRemoveUnusedMediaPermissions.js"
    ],
    "extra": {
      "eas": {
        "projectId": "d5d78fae-7a7e-46c9-8f76-31fc0c631c2b"
      }
    }
  }
}
