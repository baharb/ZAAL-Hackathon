# Not needed to build the app — EAS reinstalls dependencies from
# package.json / package-lock.json on its own build servers.
node_modules/

# Version control, editor, and local caches
.git/
.idea/
.vscode/
.npm-cache/
.expo/
.expo-*.log
*.log

# Local Gradle build output/cache — regenerated by EAS's own build, and
# archiving it can fail with EBUSY if a local gradlew build is running
# concurrently (Gradle holds lock files inside .gradle/ while it runs).
android/.gradle/
android/app/build/
android/build/

# Dev-time asset-generation tooling (Python/PowerShell scripts used to
# regenerate trace/voice/puzzle assets) — not read at build or runtime.
scripts/

# Docs, setup notes — not part of the app bundle
docs/
SETUP.md

# Publishing package (App Store / Google Play listing text + icons) —
# built for store submission, not needed to build the app itself.
store-assets/
unused-assets-report.md

# Misc scratch/debug folders and stray files accumulated during dev
checkpoint-A/
Claude outputs/
outputs/
website/
_audio_trim_backups/
_to_delete/
tmp-blink/
1.html
farsi-voice-tester.html
temp-edit.js
test_save.png
back_on_dark.png
back_on_dark2.png
be_generated_overlay.png
be_overlay.png
iran_components.png
iran_outline_test.png
iran_pieces_contact.png
iran_province_shapes_contact.png
vazir_ps_test.png

