# Build never needs these:
node_modules/
.git/
android/.gradle/
android/app/build/
android/build/
docs/
store-assets/
generated_images/
tmp_toon_test/
dist/
.expo/
*.log
# Pictures and sounds are gitignored (never pushed to GitHub) but the
# build needs them - re-include only the app's asset tree:
!assets/**/*.png
!assets/**/*.webp
!assets/**/*.jpg
!assets/**/*.mp3
