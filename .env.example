# Copy this file to ".env" and fill in your real Supabase project values
# (Project Settings -> API in the Supabase dashboard). These are safe to
# ship in the app bundle -- the anon key is meant to be public, it only
# grants what your Row Level Security / Auth rules allow.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Meta Model API (hackathon features)
# Do NOT put the Meta API key here. Anything starting with EXPO_PUBLIC_ is
# compiled into the app and is readable by anyone. The key is stored only on
# the server, as a Supabase secret:
#   supabase secrets set MODEL_API_KEY=your-key-from-dev.meta.ai
